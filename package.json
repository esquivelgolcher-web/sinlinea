{
  "name": "sinlinea",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de publicación automática en Instagram para Sin Línea (noticias de Panamá).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:render": "node --test tests/render.integration.mjs tests/logo.integration.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/panel.e2e.mjs tests/panel-maestro.e2e.mjs tests/panel-metricas.e2e.mjs tests/panel-cierre.e2e.mjs tests/panel-multicanal.e2e.mjs tests/panel-perfil.e2e.mjs",
    "generar": "node src/generar.mjs",
    "regenerar": "node src/regenerar.mjs",
    "publicar": "node src/publicar.mjs",
    "renovar-token": "node src/renovar-token.mjs",
    "build": "node src/build.mjs",
    "verificar": "node src/verificar.mjs",
    "borrador": "node src/borrador.mjs",
    "logo": "node src/logo.mjs",
    "preview": "node src/serve.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
